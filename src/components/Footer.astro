---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-brand-surface py-12 border-t border-brand-border mt-auto">
  <div class="max-w-[1200px] mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    
    <div class="flex flex-col items-center md:items-start gap-2">
      <span class="font-sora font-medium text-brand-text text-lg tracking-wide">Next G Solution</span>
      <p class="font-inter text-sm text-brand-muted">
        &copy; {currentYear} Next G Solution. All rights reserved.
      </p>
    </div>

    <nav class="flex gap-6" aria-label="Footer navigation">
      <a href="#apps" class="text-sm font-inter text-brand-muted hover:text-brand-accent transition-colors focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-sm px-1 py-0.5">
        Apps
      </a>
      <a href="#about" class="text-sm font-inter text-brand-muted hover:text-brand-accent transition-colors focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-sm px-1 py-0.5">
        About
      </a>
      <a href="#contact" class="text-sm font-inter text-brand-muted hover:text-brand-accent transition-colors focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-sm px-1 py-0.5">
        Contact
      </a>
    </nav>
    
  </div>
</footer>
