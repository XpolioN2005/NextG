---
interface Props {
  name: string;
  tagline: string;
  description: string;
  tags?: string[];
  slug: string;
  iconPath?: string;
  status?: 'live' | 'beta' | 'coming-soon';
  platform?: 'mobile' | 'desktop' | 'cross-platform';
}

const {
  name,
  tagline,
  description,
  tags = [],
  slug,
  iconPath,
  status = 'live',
  platform = 'cross-platform',
} = Astro.props;

const statusLabel: Record<string, string> = {
  live: 'Live',
  beta: 'Beta',
  'coming-soon': 'Coming Soon',
};

const platformLabel: Record<string, string> = {
  mobile: 'Mobile',
  desktop: 'Desktop',
  'cross-platform': 'Cross-Platform',
};
---

<article class="relative group bg-brand-card border border-brand-border/60 rounded-2xl overflow-hidden hover:border-brand-accent/30 hover:bg-brand-surface transition-all duration-300 hover:-translate-y-1 hover:shadow-lg flex flex-col h-full w-full">

  <!-- Preview -->
  <div class="relative h-32 sm:h-44 bg-brand-bg border-b border-brand-border/30 overflow-hidden shrink-0">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-surface/30 via-transparent to-brand-accent/5"></div>

    {iconPath ? (
      <img
        src={iconPath}
        alt={`${name} preview`}
        class="absolute inset-0 w-full h-full object-cover opacity-60"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1"
          stroke="currentColor"
          class="w-16 h-16 text-brand-border"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"
          />
        </svg>
      </div>
    )}

    <!-- Status -->
    <span class={`absolute top-3 right-3 text-xs font-medium px-2.5 py-1 rounded-full border shadow-sm ${
      status === 'live'
        ? 'text-brand-accent border-brand-accent/20 bg-black/80'
        : status === 'beta'
        ? 'text-amber-300 border-amber-400/20 bg-black/80'
        : 'text-brand-muted border-brand-border/40 bg-black/80'
    }`}>
      {statusLabel[status]}
    </span>
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-4 gap-2">

    <header>
      <h3 class="font-sora text-sm sm:text-base font-semibold text-brand-text group-hover:text-brand-accent transition-colors leading-snug line-clamp-2">
        <a href={`/apps/${slug}`} class="after:absolute after:inset-0">
          {name}
        </a>
      </h3>

      <p class="text-[10px] sm:text-xs text-brand-muted font-inter mt-0.5">
        {platformLabel[platform]}
      </p>
    </header>

    <p class="font-inter text-xs sm:text-sm text-brand-muted leading-relaxed line-clamp-2 sm:line-clamp-3">
      {tagline}
    </p>

    {tags.length > 0 && (
      <footer class="flex flex-wrap gap-1.5 pt-1">
        {tags.map(tag => (
          <span class="text-[10px] sm:text-xs font-medium text-brand-muted bg-brand-bg px-2 py-0.5 rounded-md border border-brand-border/50">
            {tag}
          </span>
        ))}
      </footer>
    )}

  </div>
</article>