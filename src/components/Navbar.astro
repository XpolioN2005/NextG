---
// Navbar.astro
---

<header class="sticky top-0 z-50 w-full transition-colors duration-300 bg-brand-surface/80 backdrop-blur-md border-b border-brand-border/50">
  <div class="max-w-[1200px] mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="text-xl font-sora font-semibold text-brand-text hover:text-brand-accent transition-colors focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-sm">
      Next G Solution
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      <a href="/apps" class="text-brand-muted hover:text-brand-accent transition-colors text-sm font-medium focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-sm px-2 py-1">
        Apps
      </a>
      <a href="/about" class="text-brand-muted hover:text-brand-accent transition-colors text-sm font-medium focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-sm px-2 py-1">
        About
      </a>
      <a href="/contact" class="text-brand-muted hover:text-brand-accent transition-colors text-sm font-medium focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-sm px-2 py-1">
        Contact
      </a>
    </nav>

    <!-- Mobile Menu Button (Minimal JS handled below or CSS only, let's use a simple checkbox hack for minimal JS, or just pure minimal script) -->
    <button id="mobile-menu-btn" class="md:hidden text-brand-text p-2 focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-sm" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <nav id="mobile-menu" class="hidden md:hidden bg-brand-surface border-b border-brand-border px-6 py-4 flex-col gap-4 shadow-lg absolute w-full" aria-label="Mobile navigation">
    <a href="/apps" class="block text-brand-text hover:text-brand-accent transition-colors font-medium py-2">Apps</a>
    <a href="/about" class="block text-brand-text hover:text-brand-accent transition-colors font-medium py-2">About</a>
    <a href="/contact" class="block text-brand-text hover:text-brand-accent transition-colors font-medium py-2">Contact</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', (!isExpanded).toString());
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>
