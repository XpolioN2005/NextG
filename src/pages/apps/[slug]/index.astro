---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const apps = await getCollection('apps');

  return apps.map((app) => ({
    params: {
      slug: app.data.slug,
    },

    props: {
      app: app.data,
    },
  }));
}

const { app } = Astro.props;
---

<Layout
  title={`${app.name} | Next G Solution`}
  description={app.description}
>
  <Navbar />

  <main class="flex-1">

    <!-- Hero -->
    <section class="relative border-b border-brand-border/50 bg-brand-surface overflow-hidden">

      <div class="absolute inset-0 bg-gradient-to-br from-brand-accent/5 via-transparent to-transparent"></div>

      <div class="relative max-w-[1200px] mx-auto px-6 py-20">

        <div class={`grid gap-12 items-center ${
          app.bannerPath
            ? 'lg:grid-cols-[1.2fr_0.8fr]'
            : 'lg:grid-cols-1'
        }`}>

          <!-- Left -->
          <div>

            <div class="flex items-center gap-5 mb-6">

              {
                app.iconPath && (
                  <img
                    src={app.iconPath}
                    alt={app.name}
                    class="w-24 h-24 rounded-3xl border border-brand-border/60 object-cover bg-brand-card"
                  />
                )
              }

              <div>

                <p class="text-sm uppercase tracking-widest text-brand-accent font-inter mb-2">
                  Application
                </p>

                <h1 class="font-sora text-4xl md:text-5xl font-semibold text-brand-text leading-tight">
                  {app.name}
                </h1>

                <p class="text-brand-muted font-inter mt-3 text-lg max-w-xl leading-relaxed">
                  {app.tagline}
                </p>

              </div>

            </div>

            <!-- Actions -->
            <div class="flex items-center gap-5 pt-4 flex-wrap">

              <!-- Primary CTA -->
              <a
                href={app.playStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-brand-accent text-black font-medium hover:opacity-90 transition"
              >
                <svg
                  role="img"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 fill-current"
                  aria-hidden="true"
                >
                  <title>Google Play</title>

                  <path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"/>
                </svg>

                <span>Get on Play Store</span>
              </a>

              <!-- Secondary Links -->
              <div class="flex items-center gap-4 text-sm font-inter">

                <a
                  href={`/apps/${app.slug}/privacy`}
                  class="text-brand-muted hover:text-brand-accent transition-colors underline underline-offset-4 decoration-brand-border hover:decoration-brand-accent"
                >
                  Privacy Policy
                </a>

                <span class="text-brand-border">•</span>

                <a
                  href={`/apps/${app.slug}/terms`}
                  class="text-brand-muted hover:text-brand-accent transition-colors underline underline-offset-4 decoration-brand-border hover:decoration-brand-accent"
                >
                  Terms & Conditions
                </a>

              </div>

            </div>

          </div>

          <!-- Right -->
          {
            app.bannerPath && (
              <div class="relative">
                <img
                  src={app.bannerPath}
                  alt={app.name}
                  class="w-full rounded-3xl border border-brand-border/50 object-cover shadow-2xl"
                />
              </div>
            )
          }

        </div>

      </div>

    </section>

    <!-- Description -->
    <section class="py-20 px-6 border-b border-brand-border/30">

      <div class="max-w-[900px] mx-auto">

        <p class="text-brand-accent text-sm font-medium tracking-widest uppercase mb-3">
          About
        </p>

        <h2 class="font-sora text-3xl font-semibold text-brand-text mb-8">
          About the App
        </h2>

        <div class="text-brand-muted font-inter text-lg leading-relaxed whitespace-pre-line">
          {app.description}
        </div>

      </div>

    </section>
    
  <!-- Screenshots -->
  {
    app.screenshots.length > 0 && (
      <section class="py-20 border-t border-brand-border/30">

        <div class="max-w-[1200px] mx-auto">

          <!-- Header -->
          <div class="px-6 mb-10">

            <p class="text-brand-accent text-sm font-medium tracking-widest uppercase mb-3">
              Gallery
            </p>

            <h2 class="font-sora text-3xl font-semibold text-brand-text">
              Screenshots
            </h2>

          </div>

          <!-- Scroll Area -->
          <div class="overflow-x-auto hide-scrollbar scroll-smooth">

            <div class="flex gap-6 px-6 pb-2">

              {
                app.screenshots.map((image) => (
                  <div class="shrink-0">

                    <div class="group overflow-hidden rounded-2xl border border-brand-border/50 bg-brand-card shadow-lg">

                      <img
                        src={image}
                        alt={`${app.name} screenshot`}
                        class="h-[560px] w-auto max-w-none object-contain transition duration-500 group-hover:scale-[1.015]"
                        loading="lazy"
                      />

                    </div>

                  </div>
                ))
              }

            </div>

          </div>

        </div>

      </section>
    )
  }

  </main>

  <Footer />
</Layout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>