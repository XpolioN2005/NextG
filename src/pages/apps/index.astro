---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AppCard from '../../components/AppCard.astro';
import { getCollection } from 'astro:content';

// Statically rendered — no client-side JS needed
const allApps = await getCollection('apps');

// Sort: featured first, then by name
const apps = allApps
  .map(entry => entry.data)
  .sort((a, b) => {
    if (b.featured && !a.featured) return 1;
    if (a.featured && !b.featured) return -1;

    return a.name.localeCompare(b.name);
  });
---

<Layout
  title="Apps | Next G Solution"
  description="Browse all games and applications published by Next G Solution. Crafted for usability and performance across mobile and desktop."
>
  <Navbar />

  <main class="flex-1">

    <!-- Page Header -->
    <section class="py-20 px-6 border-b border-brand-border/50 bg-brand-surface">
      <div class="max-w-[1200px] mx-auto">

        <p class="text-brand-accent text-sm font-medium font-inter tracking-widest uppercase mb-4">
          Our Work
        </p>

        <h1 class="font-sora text-4xl md:text-5xl font-semibold text-brand-text mb-5 leading-tight">
          Apps & Games
        </h1>

        <p class="font-inter text-brand-muted text-lg max-w-xl leading-relaxed">
          A growing catalogue of carefully made software — games and applications designed with care for modern devices.
        </p>

      </div>
    </section>

    <!-- Apps Grid -->
    <section
      class="py-20 px-6"
      aria-label="All apps and games"
    >
      <div class="max-w-[1200px] mx-auto">

        {apps.length === 0 ? (

          <p class="text-brand-muted font-inter text-center py-24 text-lg">
            No apps published yet. Check back soon.
          </p>

        ) : (

          <ul
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            role="list"
          >

            {apps.map(app => (
              <li class="flex">
                <AppCard {...app} />
              </li>
            ))}

          </ul>

        )}

      </div>
    </section>

  </main>

  <Footer />
</Layout>